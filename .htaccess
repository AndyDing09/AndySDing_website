# Serve index.html before index.php (bypasses WordPress)
DirectoryIndex index.html index.php

# Friendly 404 page
ErrorDocument 404 /404.html

  # Disable WordPress rewrite rules for root
  <IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

# ═══════════════════════════════════════════════════════════════
# SITE LOCK — CURRENTLY OFF.
#
# It is switched off because the AuthUserFile path below is still a
# placeholder. With a bad path the server cannot read any password file,
# so every login is rejected and the browser re-prompts forever.
#
# TO TURN THE LOCK ON:
#   1. Visit  https://www.andysding.com/_path.php  and send me the path
#      it prints (or read it yourself in hPanel → File Manager).
#   2. Put that real path into the AuthUserFile line below.
#   3. Create the .htpasswd file at that path with the credential line
#      you were given.
#   4. Delete the four "#" marks at the start of the lines below.
#   5. Delete _path.php — it exists only to print the path.
#
# Do not uncomment these until steps 1-3 are done, or the login loop
# comes straight back.
# ═══════════════════════════════════════════════════════════════
#AuthType Basic
#AuthName "Private site"
#AuthUserFile /home/U000000000/domains/andysding.com/asd-site-data/.htpasswd
#Require valid-user

# Never serve the password file itself, wherever it ends up.
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
