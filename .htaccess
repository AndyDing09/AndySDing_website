# ═══════════════════════════════════════════════════════════════
# SITE LOCK — ON.
#
# Every request is routed to gate.php, which serves nothing until the
# visitor enters the site password. Pages, assets, resume.pdf and the PHP
# endpoints are all behind it.
#
# The password is ONE line in a text file the server reads:
#     /home/<you>/domains/andysding.com/asd-site-data/site-password.txt
# i.e. the asd-site-data folder NEXT TO public_html (so clean-slate deploys
# never wipe it, and it never lands in the public repo). No absolute paths
# need to go in this file — gate.php finds it on its own.
#
# TO UNLOCK THE SITE AGAIN: delete the RewriteRule block below (or comment
# out the four rewrite lines). Nothing else here depends on it.
# ═══════════════════════════════════════════════════════════════

# If the rewrite ever fails to load, "/" still lands on the lock, not the site.
DirectoryIndex gate.php index.html index.php

# No directory listings, ever.
Options -Indexes

RewriteEngine On
RewriteBase /

# robots.txt stays public so crawlers can read "Disallow: /" without hitting
# a login screen. It gives nothing away.
RewriteRule ^robots\.txt$ - [L]

# Everything else -> the lock. gate.php re-serves the original path itself
# once the visitor is through, so URLs keep working exactly as before.
RewriteCond %{REQUEST_URI} !^/gate\.php$
RewriteRule ^ /gate.php [L,QSA]

# Never serve the password file or any dotfile, whatever the rewrite does.
<FilesMatch "^(\.ht|\.git|site-password\.txt)">
  Require all denied
</FilesMatch>

# Friendly 404 if a request somehow reaches Apache directly.
ErrorDocument 404 /404.html
